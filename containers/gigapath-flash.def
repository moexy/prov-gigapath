Bootstrap: docker
From: ubuntu:24.04

%files
    pixi.toml /opt/gigapath/pixi.toml
    pixi.lock /opt/gigapath/pixi.lock
    gigapath /opt/gigapath/gigapath
    scripts /opt/gigapath/scripts

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends ca-certificates curl git libgl1 libglib2.0-0 libgomp1 tar
    rm -rf /var/lib/apt/lists/*
    curl -fsSL https://github.com/prefix-dev/pixi/releases/download/v0.78.0/pixi-aarch64-unknown-linux-musl.tar.gz \
        | tar -xz -C /usr/local/bin pixi
    chmod +x /usr/local/bin/pixi
    cd /opt/gigapath
    pixi install --locked

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PYTHONPATH=/opt/gigapath
    export PATH=/opt/gigapath/.pixi/envs/default/bin:$PATH

%runscript
    exec "$@"
